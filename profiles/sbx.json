{
  "defaultProvider": "{{providers.sbx}}",
  "defaultModel": "{{models.sbx}}",
  "defaultThinkingLevel": "{{thinking.sbx}}",
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "theme": "dark",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "skills": ["~/.pi/skills"],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "{{providers.scout}}/{{models.scout}}",
        "thinking": "{{thinking.scout}}"
      },
      "researcher": {
        "model": "{{providers.researcher}}/{{models.researcher}}",
        "thinking": "{{thinking.researcher}}"
      },
      "two-axis-reviewer": {
        "model": "{{providers.reviewer}}/{{models.reviewer}}",
        "thinking": "{{thinking.reviewer}}"
      },
      "reviewer": { "disabled": true },
      "worker": { "disabled": true },
      "oracle": { "disabled": true },
      "claude-code": { "disabled": true },
      "codex-exec": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "delegate": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    }
  },
  "packages": [
    "npm:pi-web-access@0.28.0",
    "npm:pi-subagents@0.66.0",
    "npm:pi-lens@4.1.3",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:pi-mcp-adapter@2.32.0"
  ]
}
