{
  "defaultProvider": "{{provider}}",
  "defaultModel": "{{models.worker}}",
  "defaultThinkingLevel": "medium",
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "theme": "dark",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "compaction": { "enabled": true, "reserveTokens": 16384, "keepRecentTokens": 20000 },
  "skills": ["~/.pi/skills"],
  "subagents": {
    "agentOverrides": {
      "scout": { "model": "{{provider}}/{{models.scout}}", "thinking": "low" },
      "researcher": { "model": "{{provider}}/{{models.researcher}}", "thinking": "low" },
      "worker": { "disabled": true },
      "oracle": { "disabled": true },
      "claude-code": { "disabled": true },
      "codex-exec": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "reviewer": { "model": "{{provider}}/{{models.reviewer}}", "thinking": "medium" },
      "delegate": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    }
  },
  "packages": [
    "npm:pi-web-access@0.28.0",
    "npm:pi-subagents@0.66.0",
    "npm:pi-lens@4.1.3",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:pi-mcp-adapter@2.32.0"
  ]
}
