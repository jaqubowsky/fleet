{
  "defaultProvider": "{{provider}}",
  "defaultModel": "{{models.coordinator}}",
  "defaultThinkingLevel": "{{thinking.coordinator}}",
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "theme": "dark",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "compaction": { "enabled": true, "reserveTokens": 16384, "keepRecentTokens": 20000 },
  "skills": ["~/.pi/skills"],
  "subagents": {
    "agentOverrides": {
      "reviewer": { "model": "{{provider}}/{{models.reviewer}}", "thinking": "{{thinking.reviewer}}" },
      "scout": { "model": "{{provider}}/{{models.scout}}", "thinking": "{{thinking.scout}}" },
      "researcher": { "model": "{{provider}}/{{models.researcher}}", "thinking": "{{thinking.researcher}}" },
      "worker": { "disabled": true }
    }
  },
  "packages": [
    "npm:pi-lens@4.1.3",
    "npm:pi-subagents@0.66.0",
    "npm:pi-web-access@0.28.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0"
  ]
}
