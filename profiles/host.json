{
  "defaultProvider": "{{providers.host}}",
  "defaultModel": "{{models.host}}",
  "defaultThinkingLevel": "{{thinking.host}}",
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "theme": "dark",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "compaction": { "enabled": true, "reserveTokens": 16384, "keepRecentTokens": 20000 },
  "skills": ["~/.pi/skills/shared", "~/.pi/skills/host"],
  "subagents": {
    "agentOverrides": {
      "two-axis-reviewer": { "model": "{{providers.reviewer}}/{{models.reviewer}}", "thinking": "{{thinking.reviewer}}" },
      "reviewer": { "disabled": true },
      "scout": { "model": "{{providers.scout}}/{{models.scout}}", "thinking": "{{thinking.scout}}" },
      "researcher": { "model": "{{providers.researcher}}/{{models.researcher}}", "thinking": "{{thinking.researcher}}" },
      "worker": { "disabled": true }
    }
  },
  "packages": [
    "npm:pi-lens@4.1.3",
    "npm:pi-subagents@0.66.0",
    "npm:pi-web-access@0.28.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:pi-goal-x@0.31.2"
  ]
}
