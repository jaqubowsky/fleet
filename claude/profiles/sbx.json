{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "FLEET_HANDOFF_TOKENS": "250000"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/agent/fleet/claude/hooks/container.ts stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/agent/fleet/claude/hooks/container.ts pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/agent/fleet/claude/hooks/container.ts post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/agent/fleet/claude/hooks/container.ts session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/agent/fleet/claude/hooks/container.ts stop-failure",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/fleet/claude/statusline.mjs",
    "padding": 0
  },
  "attribution": {
    "sessionUrl": false,
    "commit": "",
    "pr": ""
  },
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "managedMcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "sbx-cs-4siyjVHL2MFRhraD"
      }
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "language": "Polish",
  "model": "{{models.sbx}}",
  "effortLevel": "{{thinking.sbx}}",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true
}
