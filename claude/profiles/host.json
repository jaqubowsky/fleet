{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "agentPushNotifEnabled": true,
  "autoCompactEnabled": false,
  "autoMemoryEnabled": false,
  "remoteControlAtStartup": true,
  "skipWorkflowUsageWarning": true,
  "attribution": {
    "sessionUrl": false,
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "FLEET_SEAT": "claude"
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.mjs",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|NotebookEdit|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plugin-drift.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/fleet profile --apply --brief",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ]
  },
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "extraKnownMarketplaces": {
    "harness": {
      "source": {
        "source": "directory",
        "path": "$HARNESS/claude/mods"
      }
    }
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "fleet@harness": true
  }
}
