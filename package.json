{
  "name": "harness",
  "private": true,
  "type": "module",
  "bin": {
    "fleet": "bin/fleet"
  },
  "scripts": {
    "test": "playwright-core install chromium-headless-shell && node --test 'src/*/*.test.ts' && host/tests/run.sh && python3 claude/tests/align_test.py",
    "check": "tsc --noEmit",
    "test:remote": "node --test src/remote/*.test.ts",
    "test:remote-integration": "node --test src/remote/extension.test.ts"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "marked": "18.1.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/node": "26.6.4",
    "@types/qrcode-terminal": "0.12.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
