    "test:remote-integration": "node --test src/remote/extension.test.ts"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.0",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  }
}
