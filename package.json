{
  "name": "harness",
  "private": true,
  "type": "module",
  "bin": {
    "fleet": "bin/fleet",
    "ofleet": "bin/ofleet",
    "cfleet": "bin/cfleet"
  },
  "scripts": {
    "test": "node --test 'src/*/*.test.ts' && host/tests/run.sh && python3 claude/tests/align_test.py",
