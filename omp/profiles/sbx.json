{
  "modelRoles": {
    "default": "{{providers.sbx}}/{{models.sbx}}:{{thinking.sbx}}",
    "smol": "{{providers.explorer}}/{{models.explorer}}:{{thinking.explorer}}",
    "slow": "{{providers.reviewer}}/{{models.reviewer}}:{{thinking.reviewer}}",
    "task": "{{providers.sbx}}/{{models.sbx}}:{{thinking.sbx}}",
    "advisor": "{{providers.reviewer}}/{{models.reviewer}}:{{thinking.reviewer}}"
  },
  "defaultThinkingLevel": "{{thinking.sbx}}",
  "sessionHandoff": {
    "suggestAtTokens": 250000
  },
  "extensions": [
    "~/sbx/extensions/session-handoff.ts"
  ],
  "tools": {
    "approvalMode": "yolo"
  },
  "github": {
    "enabled": true
  },
  "browser": {
    "enabled": false
  },
  "display": {
    "pinnedAgents": "collapsed",
    "smoothStreaming": false,
    "cacheMissMarker": true
  },
  "skills": {
    "enabled": true,
    "enableSkillCommands": true,
    "enablePiUser": false,
    "enablePiProject": false,
    "customDirectories": ["~/.omp/skills"]
  },
  "lsp": {
    "enabled": true,
    "lazy": true,
    "shared": false,
    "formatOnWrite": false,
    "diagnosticsOnWrite": true,
    "diagnosticsOnEdit": false
  }
}
