#!/usr/bin/env bash
set -euo pipefail

version=18.2.11
case "$(uname -s)-$(uname -m)" in
	Darwin-arm64) asset=omp-darwin-arm64; sum=faeffd57674cffa253e2f127d72ddfe6dcd81e1eb91eb5d2148913e62a010a28 ;;
	Darwin-x86_64) asset=omp-darwin-x64; sum=1271717213125a60db7882b46bb55e1ff70f7929ae801ff1176f732433835f98 ;;
	Linux-aarch64) asset=omp-linux-arm64; sum=c115f95a0a0081d3724a3c878231fb8c3b2fdb25ad5ad6c3b30d152a82b3939e ;;
	Linux-x86_64) asset=omp-linux-x64; sum=97cf39557bf3d98327dd4c9814380b7e6bcb76e41169edd9b0ff30424c733a2a ;;
	*) printf 'unsupported platform: %s-%s\n' "$(uname -s)" "$(uname -m)" >&2; exit 1 ;;
esac

tmp="$(mktemp "${TMPDIR:-/tmp}/omp-binary.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
curl -fsSL "https://github.com/can1357/oh-my-pi/releases/download/v${version}/${asset}" -o "$tmp"
printf '%s  %s\n' "$sum" "$tmp" | shasum -a 256 -c -
mkdir -p "$HOME/.local/bin"
install -m 0755 "$tmp" "$HOME/.local/bin/omp"
"$HOME/.local/bin/omp" --version
