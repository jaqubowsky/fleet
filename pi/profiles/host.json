{
  "defaultProvider": "{{providers.host}}",
  "defaultModel": "{{models.host}}",
  "defaultThinkingLevel": "{{thinking.host}}",
  "defaultProjectTrust": "ask",
  "npmCommand": ["npm", "--min-release-age=1"],
  "remote": { "autoStart": true, "port": 8787 },
  "skills": ["~/.pi/skills/shared", "~/.pi/skills/host"],
  "extensions": [
    "{{root}}/pi/extensions.ts",
    "{{root}}/extensions/statusline.ts",
    "{{root}}/extensions/pi-remote"
  ],
  "packages": [
    "npm:pi-subagents@0.76.0",
    "npm:pi-web-access@0.33.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0"
  ]
}
